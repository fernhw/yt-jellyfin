# =============================================================
# Immich environment — docker/immich/.env
# =============================================================

# ── Immich version ──────────────────────────────────────────
IMMICH_VERSION=release

# ── Storage ─────────────────────────────────────────────────
# Photos/uploads on HDD (bulk storage)
UPLOAD_LOCATION=/Volumes/Darrel4tb/sim

# Postgres data on local SSD (fast I/O)
DB_DATA_LOCATION=/Users/alexander-highground/immich/postgres

# ML model cache on local SSD
MODEL_CACHE_LOCATION=/Users/alexander-highground/immich/model-cache

# ── Database ─────────────────────────────────────────────────
DB_USERNAME=immich
DB_DATABASE_NAME=immich
# ⚠️  Change this before first boot
DB_PASSWORD=CHANGE_ME_BEFORE_FIRST_BOOT

DB_HOSTNAME=database

# ── Redis ────────────────────────────────────────────────────
REDIS_HOSTNAME=redis

# ── Optional ─────────────────────────────────────────────────
# Uncomment to set the public URL (used in share links)
# IMMICH_SERVER_URL=https://photos.fernhw.com
